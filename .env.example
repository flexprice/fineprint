# ── models ───────────────────────────────────────────────────────────────────
# Every lab routes through one OpenRouter key (recommended).
OPENROUTER_API_KEY=

# Optional: run OpenAI models directly instead of via OpenRouter.
OPENAI_API_KEY=

# ── corpus prep (optional) ───────────────────────────────────────────────────
# OCR raw contract PDFs into the harness's input format (Datalab).
CHANDRA_OCR_API_KEY=

# ── bring your own private data (optional overrides) ─────────────────────────
# FINEPRINT_GROUND_TRUTH=/abs/path/to/ground_truth.xlsx
# FINEPRINT_OCR_DIR=/abs/path/to/ocr-pickles
# FINEPRINT_N_RUNS=3
# FINEPRINT_WORKERS=8

# ── autonomous watch loop (fineprint/watch.py, optional) ─────────────────────
# SLACK_WEBHOOK_URL=
# VERCEL_DEPLOY_HOOK_URL=
# FINEPRINT_SITE_URL=https://your-fineprint.vercel.app
