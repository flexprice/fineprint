# ── secrets (never commit) ───────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ── private benchmark data (bring your own — keeping it private is the point) ──
*.pkl
.ocr_cache/
data/ground_truth.xlsx
fineprint/data/ocr/
fineprint/data/ground_truth.xlsx
fineprint/results/
fineprint/roster.json
fineprint/data/seen_models.json
fineprint/corpus/raw/
fineprint/corpus/manifest.json

# ── node / next.js (fineprint/web) ───────────────────────────────────────────
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
# Generated by next dev / next build, and the two write different contents — it churned in
# every PR depending on which command you ran last. Regenerated on build, so nothing needs it
# in the tree (this is what create-next-app ignores by default too).
next-env.d.ts
.vercel/
npm-debug.log*
yarn-error.log*

# ── os / editor ──────────────────────────────────────────────────────────────
.DS_Store
*.log
.idea/
.vscode/

# deploy: never commit private seed mapping
deploy/private/
fineprint/seed_contracts.json
